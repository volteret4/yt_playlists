# Copia este fichero a .env y rellénalo. Los valores vacíos son obligatorios u opcionales según el README.

AIRSONIC_PASS=
AIRSONIC_URL=
AIRSONIC_USER=
DB_PATH=/app/yt_playlists.db
LASTFM_API_KEY=
MUSICA_LOCAL_DB=/musica_local.sqlite
YOUTUBE_API_KEY=

# ── docker-compose.yml ──────────────────────────────────────────
# Carpeta con musica_local.sqlite (de music-fuzzy, o creada con `crear_musica_local.py` de [mapa_discos](https://github.com/volteret4/mapa_discos))
MUSICA_LOCAL_DIR=./datos/musica_local
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
